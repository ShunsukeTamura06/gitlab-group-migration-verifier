# ローカル検証専用。コピー後の.envだけを編集し、実環境の認証情報をコミットしないでください。
SOURCE_GITLAB_ROOT_PASSWORD=change-this-source-local-password
DESTINATION_GITLAB_ROOT_PASSWORD=change-this-destination-local-password

# 社内CAを使う場合は、ホスト上のPEM Bundleを絶対パスで指定します。
# SOURCE_GITLAB_CA_BUNDLE=/absolute/path/to/corporate-ca.pem
# DESTINATION_GITLAB_CA_BUNDLE=/absolute/path/to/corporate-ca.pem
