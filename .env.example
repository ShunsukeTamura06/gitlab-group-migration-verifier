# 実際のTokenはファイルに保存せず、Secrets Manager等から環境変数へ注入してください。
SOURCE_GITLAB_URL=https://gitlab-old.internal.example
SOURCE_GITLAB_TOKEN=
DESTINATION_GITLAB_URL=https://gitlab-new.internal.example
DESTINATION_GITLAB_TOKEN=

# 社内CAを使う場合は、PEM Bundleを絶対パスで指定します。
# SOURCE_GITLAB_CA_BUNDLE=/absolute/path/to/corporate-ca.pem
# DESTINATION_GITLAB_CA_BUNDLE=/absolute/path/to/corporate-ca.pem

GITLAB_API_TIMEOUT=60
GITLAB_API_MAX_RETRIES=4
